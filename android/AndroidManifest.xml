    </activity>
    <service android:name=".PlaybackService" android:exported="false" android:foregroundServiceType="mediaPlayback"/>
    <service android:name=".ImportService" android:exported="false" android:foregroundServiceType="dataSync"/>
    <service android:name=".DownloadService" android:exported="false" android:foregroundServiceType="dataSync"/>
    <service android:name=".DownloadBatchJob" android:exported="false" android:permission="android.permission.BIND_JOB_SERVICE"/>
    <receiver android:name=".DownloadActions" android:exported="false"/>
